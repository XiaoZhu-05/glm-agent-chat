# 复制本文件为 .env 并填写你自己的配置
# GLM 开放平台 https://open.bigmodel.cn 的 API Key
GLM_API_KEY=你的APIKey
# OpenAI 兼容接口地址（智谱开放平台）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 默认模型
GLM_MODEL=glm-5.3
# 界面上可切换的模型列表（逗号分隔）
GLM_MODELS=glm-5.3,glm-4.6,glm-4.5-air,glm-4.5-flash,glm-4-flash
# 服务端口
PORT=3210
# 单轮对话最大工具调用步数 / 命令超时 / 工具输出最大字符数
AGENT_MAX_STEPS=8
CMD_TIMEOUT_MS=30000
MAX_TOOL_OUTPUT=6000
