# 复制本文件为 .env 并填写你自己的配置
# GLM 开放平台 https://open.bigmodel.cn 的 API Key
GLM_API_KEY=你的APIKey
# OpenAI 兼容接口地址（智谱开放平台）
# ⚠️ GLM Coding Plan 订阅 key 请改用 https://open.bigmodel.cn/api/coding/paas/v4
#    （订阅 key 走通用端点时付费模型会报 429「余额不足或无可用资源包」）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 默认模型
GLM_MODEL=glm-5.3
# 界面上可切换的模型列表（逗号分隔；glm-4v-flash 为免费视觉模型）
GLM_MODELS=glm-5.3,glm-4.6,glm-4.5-air,glm-4.5-flash,glm-4-flash,glm-4v-flash
# 支持图片输入的视觉模型列表
GLM_VISION_MODELS=glm-4v-flash,glm-4.5v,glm-4.6v
# 单张图片大小上限（字节，默认 5MB）、单条消息图片数上限
IMAGE_MAX_BYTES=5242880
MAX_IMAGES_PER_MESSAGE=4
# 服务端口
PORT=3210
# NVIDIA NIM API Key（BioNeMo ESMFold 蛋白结构预测），免费注册：https://build.nvidia.com
NVIDIA_API_KEY=nvapi-你的key
# NIM 请求超时（毫秒），结构预测较慢默认 120s
NIM_TIMEOUT_MS=120000
# Biomni 子 agent：独立 venv 内 python 的绝对路径（venv 需预装 biomni/pandas/langchain_openai/tqdm）
BIOMNI_PYTHON=/path/to/biomni-venv/bin/python
# Biomni 使用的 LLM（走 GLM 兼容端点，复用 GLM_API_KEY）
BIOMNI_MODEL=glm-4.5-flash
# Biomni 单任务超时（毫秒）
BIOMNI_TIMEOUT_MS=300000
# EveryInfra 数据平台（https://everyinfra.com，86+ 平台数据采集 / 17 种搜索工具）
# 到 https://console.everyinfra.com 注册，在 Billing 页兑换额度码并创建 API key（sk- 开头）
EVERYINFRA_API_KEY=sk-你的key
# API 地址（一般不用改；仅供测试指向内网 mock）
# EVERYINFRA_BASE_URL=https://api.everyinfra.com
# 单次请求超时（毫秒）
# EVERYINFRA_TIMEOUT_MS=30000
# 异步任务（202+job_id）最长等待（毫秒），超时后可用 kind=job 手动续查
# EVERYINFRA_JOB_MAX_WAIT_MS=120000
# 代理（可选）：api.everyinfra.com 部分网络直连不通时配置本机代理端口
# （内置 CONNECT 隧道实现，零依赖，无需安装任何包；常见端口：Clash Verge 7897 / Clash 7890 / v2ray 10809）
# EVERYINFRA_PROXY=http://127.0.0.1:7897
# 单轮对话最大工具调用步数 / 命令超时 / 工具输出最大字符数
AGENT_MAX_STEPS=8
CMD_TIMEOUT_MS=30000
MAX_TOOL_OUTPUT=6000
# 文档上传：大小上限、PDF 最大提取页数、Excel 每 sheet 最大行数、附件注入上下文的最大字符数
UPLOAD_MAX_BYTES=10485760
PDF_MAX_PAGES=30
XLSX_MAX_ROWS=200
MAX_ATTACHMENT_CHARS=8000
# Python 解释器（PDF/Excel 解析依赖 pypdf 与 openpyxl；缺失时上传会返回友好报错）
PYTHON_BIN=python
# 超过该消息条数时截断中段历史（保留首条 user + 最近 N 条 + 截断标记）
CONTEXT_WINDOW_MESSAGES=40
